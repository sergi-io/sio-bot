  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "internalConsoleOptions": "openOnSessionStart",
      "request": "launch",
      "name": "Debug File",
      "program": "dev",
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false,
      "watchMode": false
    },
    {
      "type": "bun",
      "internalConsoleOptions": "openOnSessionStart",
      "request": "launch",
      "name": "Run Bot - DEV",
      "program": "dev",
      "cwd": "${workspaceFolder}",
      "noDebug": false,
      "watchMode": false
    },
    {
      "type": "bun",
      "internalConsoleOptions": "openOnSessionStart",
      "request": "launch",
      "name": "Run BackTest - DEV",
      "program": "backtest",
      "args": ["\"2026-02-23\"", "\"2026-02-27\""],
      "cwd": "${workspaceFolder}",
      "noDebug": false,
      "watchMode": false
    },
    {
      "type": "bun",
      "internalConsoleOptions": "openOnSessionStart",
      "request": "launch",
      "name": "Run Config Optimizer (Genetic) - DEV",
      "program": "config-optimizer-genetic",
      "cwd": "${workspaceFolder}",
      "noDebug": false,
      "watchMode": false
    },
    {
      "type": "bun",
      "internalConsoleOptions": "openOnSessionStart",
      "request": "launch",
      "name": "Run Config Optimizer (Bayesian) - DEV",
      "program": "config-optimizer-bayesian",
      "cwd": "${workspaceFolder}",
      "noDebug": false,
      "watchMode": false
    },
    {
      "type": "bun",
      "internalConsoleOptions": "openOnSessionStart",
      "request": "attach",
      "name": "Attach Bun",
      "url": "ws://localhost:6499/",
      "stopOnEntry": false
    }
  ]
}
