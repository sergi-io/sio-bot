#################################################################
# GENERAL CONFIG
#################################################################
# Env could be dev / prod / test.
SIOBOT_IS_BINARY=false
SIOBOT_BUNX_PATH=bunx
SIOBOT_PROJECT_NAME=SioBot
SIOBOT_ENV=dev
SIOBOT_SHOW_INIT_BANNER=true
SIOBOT_NOTIFICATIONS_ENABLED=true
SIOBOT_SEND_TO_BID_CHANNEL=true
SIOBOT_TELEGRAM_BOT_TOKEN=
SIOBOT_TELEGRAM_ALLOWED_USER_IDS=0
SIOBOT_TELEGRAM_BBW_CHANNEL_ID=0
SIOBOT_EXCHANGE_ID=phemex
SIOBOT_PHEMEX_API_ID=
SIOBOT_PHEMEX_API_SECRET=
SIOBOT_BITGET_API_KEY=
SIOBOT_BITGET_API_SECRET=
SIOBOT_BITGET_PASSWORD=
SIOBOT_BITGET_TESTNET_ENABLED=false
SIOBOT_SSH_PORT=22
SIOBOT_SSH_USERNAME=root
SIOBOT_SSH_HOST=host.foo.com
#################################################################
# NEXUS
#################################################################
SIOBOT_NEXUS_AGGR_SOCKET_PATH=/tmp/sio-nexus-aggr.sock
SIOBOT_NEXUS_CONTROL_SOCKET_PATH=/tmp/sio-nexus-control.sock
SIOBOT_NEXUS_QUERY_SOCKET_PATH=/tmp/sio-nexus-query.sock
SIOBOT_NEXUS_SCANNER_SOCKET_PATH=/tmp/sio-nexus-scanner.sock
#################################################################
# PAPER TRADE
#################################################################
SIOBOT_PAPER_TRADE_ENABLED=true
SIOBOT_PAPER_TRADE_INITIAL_BALANCE=1000
#################################################################
# BACKTEST
#################################################################
SIOBOT_BACK_TEST_INITIAL_BALANCE=1000
SIOBOT_BACK_TEST_DATE_START=2025-12-01
SIOBOT_BACK_TEST_DATE_END=2025-12-31
#################################################################
# Config Optimizer
#################################################################
SIOBOT_RUN_CONFIG_OPTIMIZER_EVERY_SECONDS=3600
SIOBOT_RUN_CONFIG_OPTIMIZER_AFTER_EVERY_TRADE=true
SIOBOT_RUN_CONFIG_OPTIMIZER_AT_STARTUP=true
#################################################################
# JOURNAL
#################################################################
SIOBOT_JOURNAL_ENABLED=true
SIOBOT_JOURNAL_DIR=./outputs/journal
#################################################################
# FRONTEND
#################################################################
SIOBOT_FRONTEND_ENABLED=true
SIOBOT_FRONTEND_PORT=8787
#################################################################
# LOGGER
#################################################################
SIOBOT_LOG_DIR=./logs
SIOBOT_LOG_ENABLED=true
SIOBOT_WRITE_LOG_TO_FILES=true
# LOG Levels from TOP to BOTTOM ------>----->------>------>----->------>
# Values for SIOBOT_LOGGER_LEVEL: fatal, error, warn, info, debug, trace
# Take into account that the logger will always log the messages with level "warn" and above
# Note: all successful HTTP requests are logged with level "trace"
# If you want to see all the logs, you should set the level to "trace"
# Recommended value for production: info
# Recommended value for development: debug or trace 
SIOBOT_LOG_LEVEL=debug
#################################################################
