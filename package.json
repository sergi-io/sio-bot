{
  "name": "sio-bot",
  "version": "1.6.7",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "bun run generate-templates && bun run --watch src/main.ts run",
    "dev:indicators": "bun run generate-templates && bun run --watch src/main.ts indicator-dashboard",
    "start": "bun run generate-templates && bun run dist/main.js",
    "clean": "rimraf ./build ./logs",
    "clean:all": "bun run clean && rimraf ./src/db/migrations",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ./src --max-warnings=0",
    "frontend:typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "upgrade-packages-interactive": "bunx npm-check-updates -ui",
    "generate-templates": "bun run scripts/generate-journal-templates.ts",
    "build": "bun run generate-templates && SIOBOT_IS_BINARY=true bun build --compile --minify --minify-whitespace --minify-syntax --target=bun-linux-x64 --bytecode --root src --outfile build/x64/sio-bot ./src/main.ts ./src/backtester/configOptimizer/ConfigOptimizerWorker.ts",
    "build:mac": "bun run generate-templates && SIOBOT_IS_BINARY=true bun build --compile --minify --minify-whitespace --minify-syntax --target=bun-darwin-arm64 --bytecode --root src --outfile build/darwin-arm64/sio-bot ./src/main.ts ./src/backtester/configOptimizer/ConfigOptimizerWorker.ts",
    "deploy": "sh scripts/deploy.sh",
    "upload-bot-config": "sh scripts/upload-bot-config.sh",
    "prepare": "husky",
    "backtest": "bun run src/main.ts backtest",
    "config-optimizer-brute-force": "SIOBOT_LOG_ENABLED=false bun run src/main.ts config-optimizer-brute-force",
    "config-optimizer-genetic": "SIOBOT_LOG_ENABLED=false bun run src/main.ts config-optimizer-genetic",
    "download-historical-data": "bun run src/main.ts download-historical-data",
    "indicator-dashboard": "bun run generate-templates && bun run src/main.ts indicator-dashboard",
    "nexus-info": "bun run src/main.ts nexus-info",
    "nexus-dashboard": "bun run src/main.ts nexus-dashboard",
    "generate-journal": "bun run generate-templates && bun run src/main.ts generate-journal",
    "open-journal": "sh scripts/open-journal.sh",
    "apply-best-config": "sh scripts/apply-best-config.sh",
    "apply-best-config-bruteforce": "sh scripts/apply-best-config-bruteforce.sh"
  },
  "dependencies": {
    "@grammyjs/menu": "1.3.1",
    "@types/blessed": "^0.1.27",
    "@types/workerpool": "9.0.0",
    "ansis": "4.2.0",
    "blessed": "^0.1.81",
    "ccxt": "4.5.52",
    "commander": "14.0.3",
    "csv-parse": "6.2.1",
    "csv-stringify": "6.7.0",
    "grammy": "1.42.0",
    "lodash": "4.18.1",
    "log-symbols": "7.0.1",
    "nanoid": "5.1.11",
    "ora": "9.4.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "protobufjs": "8.2.0",
    "rimraf": "6.1.3",
    "trading-signals": "7.4.3",
    "typescript": "6.0.3",
    "workerpool": "10.0.2",
    "ws": "8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.3.13",
    "@types/eslint__js": "9.14.0",
    "@types/lodash": "4.17.24",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.4",
    "prettier": "3.8.3",
    "typescript-eslint": "8.59.2"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --cache --max-warnings=0"
    ]
  },
  "module": "src/index.ts",
  "type": "module",
  "private": true
}
